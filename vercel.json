{
  "version": 2,
  "builds": [
    {
      "src": "api/alexa.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/alexa",
      "dest": "/api/alexa.js",
      "methods": ["POST", "OPTIONS"]
    }
  ],
  "functions": {
    "api/alexa.js": {
      "maxDuration": 30
    }
  }
}